{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ohel",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Pages go through the Worker so each link gets its own preview (title, picture); files go straight out.
    "run_worker_first": ["/*", "!/assets/*", "!/icon.svg", "!/og.jpg", "!/manifest.webmanifest"]
  },
  "vars": {
    // Cloudflare Web Analytics (no cookies). Empty = no beacon.
    "ANALYTICS_TOKEN": "543355d1bcb34ebb945ccba7570509e1"
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "observability": { "enabled": true }
}
